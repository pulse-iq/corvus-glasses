# Copy to .env.local for local development. Set these on the dedicated
# corvus-glasses Vercel project for deployment. Never use NEXT_PUBLIC_ for secrets.
CORVUS_GLASSES_TOKEN=
CORVUS_LIVEKIT_URL=
CORVUS_LIVEKIT_API_KEY=
CORVUS_LIVEKIT_API_SECRET=

# Dedicated Upstash Redis database for mission allocation, terminal records,
# and recording reconciliation. Keep terminal IDs; do not expire tombstones.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# No AWS configuration here. Recordings and the worker's manifests are written
# by LiveKit Egress and the worker (agent/.env); this service never reads them.

# Vercel Workflow selects its hosted backend automatically on Vercel;
# npm run dev uses local workflow storage. No extra service URL is needed.
