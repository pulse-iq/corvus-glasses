# Copy to .env at the repo root and fill in. Gitignored.
#
# These are for the tooling that runs on your machine: the Stage 1 detector
# benchmark today, the LiveKit agent and gateway if we go that way later.
# The iOS app does NOT read this file -- an app bundle has no environment.
# Its keys live in samples/CameraAccess/CameraAccess/Secrets.swift.

# The default Stage 1 detector. GEMINI_API_KEY is accepted as an alias.
GOOGLE_API_KEY=

# Only needed to benchmark these backends against Gemini.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
