# Copy to .env at the repo root and fill in. Gitignored, along with every
# .env.* variant, so only this template is ever committed.
#
# This is the single place secrets go. `/setup-corvus` reads it and writes
# samples/CameraAccess/CameraAccess/Secrets.swift for you -- an app bundle has
# no environment, so the app needs its keys compiled in, but you should not have
# to paste them anywhere by hand.
#
# Two other .env files exist in this project and you almost certainly do not
# need either: agent/.env is only for deploying the realtime worker, which is
# already deployed, and the token endpoint's environment lives with that
# deployment, not here.

# Required. The watcher's vision model and the conversational interceptor both
# use it. Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY is accepted as an alias.
GOOGLE_API_KEY=

# Required only for the realtime interceptor, which is not the default. It
# authenticates against the deployed token endpoint; ask whoever runs that
# deployment. Leave empty to run scripted or conversational intercepts, which
# need no server at all.
CORVUS_GLASSES_TOKEN=

# Optional. Only needed to benchmark the other detector backends against Gemini
# -- see corvus-tools/. The app runs on Gemini without these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
